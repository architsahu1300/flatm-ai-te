# Spring Boot reads these from the process environment (export them or use your IDE run config).
# Everything has a dev default in application.yml — only OPENAI_API_KEY changes behavior meaningfully.

# OpenAI (omit entirely to run with the deterministic mock AI provider)
OPENAI_API_KEY=

# Database (docker-compose default)
DB_URL=jdbc:postgresql://localhost:5433/flatmaite
DB_USER=flatmaite
DB_PASSWORD=flatmaite

# Auth
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef0123456789
# Google OAuth (leave empty to hide Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI controls
AI_MOCK=auto
AI_EXPLANATIONS_ENABLED=true
AI_DAILY_SEARCH_LIMIT=50
AI_DAILY_COST_LIMIT_USD=0.50
